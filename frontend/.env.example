# Copy to .env.local for local development.
# In Vercel, add the same variables for Production and Preview.

# Gemini API key from https://aistudio.google.com (server only)
GOOGLE_GENERATIVE_AI_API_KEY=

# Supabase project URL and keys (from the Supabase dashboard, API keys section)
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_...) or legacy "anon" key. Safe for the browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_...) or legacy "service_role" key. Server only, never expose.
SUPABASE_SECRET_KEY=

# Access gate (server only, never NEXT_PUBLIC_). Generate, don't choose by hand:
# openssl rand -base64 24
APP_PASSWORD=
# openssl rand -base64 32
SESSION_SECRET=
